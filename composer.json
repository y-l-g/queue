{
  "name": "pogo/queue-monorepo",
  "description": "Pogo Queue Drivers Monorepo",
  "type": "project",
  "license": "MIT",
  "private": true,
  "require": {
    "php": ">=8.2",
    "laravel/framework": "^10.0 || ^11.0 || ^12.0",
    "laravel/octane": "^2.0",
    "symfony/config": "^6.4 || ^7.0 || ^8.0",
    "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
    "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
    "symfony/messenger": "^6.4 || ^7.0 || ^8.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0 || ^9.0",
    "phpunit/phpunit": "^10.0 || ^11.0",
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^1.10",
    "monorepo-php/monorepo": "^12.4"
  },
  "autoload": {
    "psr-4": {
      "Pogo\\Queue\\Laravel\\": "packages/laravel/src/",
      "Pogo\\Queue\\Symfony\\": "packages/symfony/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pogo\\Queue\\Laravel\\Tests\\": "packages/laravel/tests/",
      "Pogo\\Queue\\Symfony\\Tests\\": "packages/symfony/tests/"
    }
  },
  "replace": {
    "pogo/laravel-queue": "self.version",
    "pogo/symfony-queue": "self.version"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
