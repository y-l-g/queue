{
  "name": "pogo/queue-monorepo",
  "description": "Pogo Queue Drivers Monorepo",
  "type": "project",
  "license": "MIT",
  "private": true,
  "require": {
    "php": "^8.5",
    "laravel/framework": "^13.0",
    "laravel/octane": "^2.0",
    "symfony/config": "^8.0",
    "symfony/dependency-injection": "^8.0",
    "symfony/http-kernel": "^8.0",
    "symfony/messenger": "^8.0"
  },
  "require-dev": {
    "orchestra/testbench": "^11.0",
    "phpunit/phpunit": "^13.1",
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.1",
    "monorepo-php/monorepo": "^12.7",
    "symfony/framework-bundle": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "Pogo\\Queue\\Laravel\\": "packages/laravel/src/",
      "Pogo\\Queue\\Symfony\\": "packages/symfony/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pogo\\Queue\\Laravel\\Tests\\": "packages/laravel/tests/",
      "Pogo\\Queue\\Symfony\\Tests\\": "packages/symfony/tests/"
    }
  },
  "replace": {
    "pogo/laravel-queue": "self.version",
    "pogo/symfony-queue": "self.version"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
